# Copie para .env e ajuste. NUNCA faça commit do .env.

# --- Desenvolvimento ------------------------------------------------------------------
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Bate com o docker-compose.yml da raiz do projeto
DATABASE_URL=mysql://precons:precons@127.0.0.1:3307/precons

# --- Produção (configure no painel do host, não neste arquivo) ------------------------
# SECRET_KEY=<gere com: python -c "import secrets; print(secrets.token_urlsafe(50))">
# EMAIL_PEPPER=<obrigatória; gere igual à SECRET_KEY e NUNCA troque depois de ter contas> (PRIVACIDADE.md)
# DEBUG=False
# ALLOWED_HOSTS=sua-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://www.upkeeper.online,https://upkeeper.online
# CSRF_TRUSTED_ORIGINS=https://sua-api.onrender.com
# DATABASE_URL=postgres://usuario:senha@host:5432/banco    (ou mysql://...)
#
# Opcionais (já têm padrão):
# SECURE_HSTS_SECONDS=86400            suba para 31536000 quando tudo estiver estável
# THROTTLE_DECK_IMPORT=30/hour         importações de deck por usuário
# THROTTLE_ROOM_CREATE=30/hour         salas criadas por usuário/IP
# THROTTLE_ROOM_JOIN=60/hour
# THROTTLE_DRAW=120/hour               sorteios por usuário/IP
# THROTTLE_AUTH=20/min                 tentativas de login/cadastro por IP
# LOG_LEVEL=INFO
#
# Segurança:
# ADMIN_PATH=admin/                    troque por um caminho que ninguém adivinhe, ex.: gestao-8f3k2/
# TRUSTED_PROXIES=0                    proxies na frente do servidor (veja /api/admin/request-info/)
# LOGIN_MAX_FAILURES=10                senhas erradas seguidas numa conta antes de bloquear o login dela
# LOGIN_LOCK_MINUTES=15
# TABLE_MAX=40                         mesas virtuais abertas ao mesmo tempo no servidor
# TABLES_PER_USER=3                    mesas novas abertas por conta ao mesmo tempo
#
# Login com Google e Discord (sem as chaves, o botão não aparece):
# FRONTEND_URL=https://www.upkeeper.online   o serviço volta para FRONTEND_URL/entrar/social/<google|discord>
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID= / DISCORD_CLIENT_SECRET=
#
# Recuperação de senha por e-mail (API do Resend; sem a chave, o link "Esqueceu a senha?" não aparece):
# RESEND_API_KEY=re_xxx                chave de API do Resend
# DEFAULT_FROM_EMAIL=Upkeeper <nao-responda@upkeeper.online>
#
# Curadoria do Instagram (README, "Curadoria do Instagram"); desligada sem SOCIAL_CURATION_ENABLED=true:
# SOCIAL_CURATION_ENABLED=true
# SOCIAL_SLOTS=12:00,19:00             horários de Brasília
# SOCIAL_AUTO_APPROVE=false            true: repost de perfil autorizado sai sem passar pelo painel
# APIFY_TOKEN=apify_api_xxx
# ANTHROPIC_API_KEY=sk-ant-xxx          editor da curadoria (Claude)
# CLOUDINARY_URL=cloudinary://chave:segredo@nuvem
# INSTAGRAM_USER_ID=                   conta profissional do Upkeeper
# INSTAGRAM_ACCESS_TOKEN=              de preferência de usuário do sistema (não expira)
