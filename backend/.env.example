#
# Opcionais (já têm padrão):
# SECURE_HSTS_SECONDS=86400            suba para 31536000 quando tudo estiver estável
# THROTTLE_DECK_IMPORT=30/hour         importações de deck por usuário
# THROTTLE_ROOM_CREATE=30/hour         salas criadas por usuário/IP
# THROTTLE_ROOM_JOIN=60/hour
# THROTTLE_DRAW=120/hour               sorteios por usuário/IP
# THROTTLE_AUTH=20/min                 tentativas de login/cadastro por IP
# LOG_LEVEL=INFO
