# Deixe vazio em desenvolvimento (o proxy do Vite repassa /api para localhost:8000).
# Em produção (Vercel), defina com a URL do backend, ex.: https://choose-at-random.onrender.com
VITE_API_URL=

# E-mail de contato exibido na política de privacidade (pedidos sobre dados pessoais / LGPD)
VITE_CONTACT_EMAIL=

# Opcional: URL pública do site, usada na imagem de prévia de links (WhatsApp, Discord...).
# Na Vercel não precisa: o domínio de produção é detectado automaticamente no build.
# VITE_SITE_URL=https://seu-dominio.com

# Doações por Pix na página Apoie (sem as três, a página mostra só o Ko-fi).
# Use chave aleatória ou e-mail (nunca CPF/telefone: a chave aparece na página).
# Nome e cidade: até 25 e 15 letras, sem acento (o app do banco mostra o nome do titular de qualquer jeito).
# VITE_PIX_KEY=
# VITE_PIX_NAME=
# VITE_PIX_CITY=
